 16px"><tbody><tr style="width:100%"><td><p style="font-size:20px;line-height:24px;color:#C8FF2E;font-weight:700;margin:0 0 32px;margin-top:0;margin-right:0;margin-bottom:32px;margin-left:0">Na, mit iszunk?</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#151518;border:1px solid #2A2A2F;border-radius:16px;padding:24px"><tbody><tr><td><h1 style="color:#F5F5F7;font-size:24px;font-weight:600;line-height:1.2;margin:0 0 16px">We got your order</h1><p style="font-size:20px;line-height:1.3;color:#F5F5F7;font-weight:600;border:2px solid #F59E0B;border-radius:10px;padding:12px 16px;margin:0 0 24px;text-align:center;margin-top:0;margin-right:0;margin-bottom:24px;margin-left:0">This is not a receipt</p><p style="font-size:12px;line-height:24px;color:#A1A1AA;font-weight:500;letter-spacing:0.04em;text-transform:uppercase;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">Order number</p><p style="font-size:48px;line-height:1;color:#C8FF2E;font-weight:800;font-variant-numeric:tabular-nums;margin:0 0 24px;margin-top:0;margin-right:0;margin-bottom:24px;margin-left:0">A42</p><p style="font-size:16px;line-height:1.5;color:#F5F5F7;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Pilot Club is making it. We will tell you when you can pick it up at the bar.</p><p style="font-size:16px;line-height:1.5;color:#F5F5F7;margin:0 0 8px;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">2<!-- --> × <!-- -->Csapolt sör 0,5 l<!-- --> <span style="font-variant-numeric:tabular-nums;white-space:nowrap">3 980 Ft</span></p><p style="font-size:16px;line-height:1.5;color:#F5F5F7;margin:0 0 8px;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">1<!-- --> × <!-- -->Gin tonic<!-- --> <span style="font-variant-numeric:tabular-nums;white-space:nowrap">2 490 Ft</span></p><p style="font-size:16px;line-height:1.5;color:#F5F5F7;margin:16px 0 0;font-weight:600;marg