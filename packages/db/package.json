{
  "name": "@namitiszunk/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "verify-restore": "node scripts/verify-restore.ts",
    "check-transaction": "node scripts/check-transaction.ts",
    "seed": "node --env-file-if-exists=../../apps/api/.env.local --import ./scripts/ts-resolve.ts scripts/seed.ts",
    "seed:e2e": "node --import ./scripts/ts-resolve.ts scripts/seed.ts --e2e"
  },
  "devDependencies": {
    "@namitiszunk/config": "workspace:*",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "mongodb": "7.8.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "mongoose": "9.12.0",
    "server-only": "^0.0.1"
  }
}
